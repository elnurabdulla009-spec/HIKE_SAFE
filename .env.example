# Copy to .env and fill in from Supabase → Connect (or Project Settings → API Keys).
# The anon/publishable key is meant to be public: Row Level Security is what protects the data.
# NEVER put the service_role / secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Which backend the app uses: "mock" (default, no server needed) or "real" (Supabase).
EXPO_PUBLIC_API=mock
